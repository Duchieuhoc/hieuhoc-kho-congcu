+        # chọn ab, bc; giải cd, da để Σ cạnh·hướng = 0 (khép kín)
+        det = uCD[0] * uDA[1] - uDA[0] * uCD[1]
+        if abs(det) < 1e-9:
+            raise ValueError("[tu_giac_goc] cạnh CD ∥ DA — không khép được; đổi góc.")
+        rx = -(ab * uAB[0] + bc * uBC[0]); ry = -(ab * uAB[1] + bc * uBC[1])
+        cd = (rx * uDA[1] - uDA[0] * ry) / det
+        da = (uCD[0] * ry - rx * uCD[1]) / det
+        if cd <= 0.05 or da <= 0.05:
+            raise ValueError(f"[tu_giac_goc] cạnh gợi ý ab={ab}, bc={bc} không khép thành tứ giác lồi "
+                             f"(CD={cd:.2f}, DA={da:.2f}≤0). Đổi ab/bc cho cân.")
+        ox, oy = goc_o
+        ax, ay = ox + 0.0, oy + 0.0
+        bx, by = ax + ab * uAB[0], ay + ab * uAB[1]
+        cx, cy = bx + bc * uBC[0], by + bc * uBC[1]
+        dx, dy = cx + cd * uCD[0], cy + cd * uCD[1]
+        self._diem(A, ax, ay, 'above left', moc=True); self._diem(B, bx, by, 'above right', moc=True)
+        self._diem(Cc, cx, cy, 'below right', moc=True); self._diem(D, dx, dy, 'below left', moc=True)
+        self._da_giac(A, B, Cc, D)
