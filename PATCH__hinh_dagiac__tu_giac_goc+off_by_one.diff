+        import math as _m
+        gD = 360.0 - (float(goc_A) + float(goc_B) + float(goc_C))
+        for nm, g in (('A', goc_A), ('B', goc_B), ('C', goc_C), ('D', gD)):
+            if not (0.0 < g < 180.0):
+                raise ValueError(f"[tu_giac_goc] góc {nm} = {g:.2f}° không hợp lệ cho tứ giác LỒI "
+                                 f"(mỗi góc phải 0°<g<180°; tổng 3 góc khai = {goc_A+goc_B+goc_C}).")
+        # đi quanh chu vi A→B→C→D→A; hướng cạnh, rẽ tại đỉnh ĐẾN theo góc trong đỉnh đó
